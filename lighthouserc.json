{
  "ci": {
    "collect": {
      "staticDistDir": "./.lighthouse-site",
      "url": [
        "http://localhost/My-Porfolio/index.html",
        "http://localhost/My-Porfolio/about/index.html",
        "http://localhost/My-Porfolio/projects/index.html",
        "http://localhost/My-Porfolio/writeups/index.html",
        "http://localhost/My-Porfolio/contact/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "color-contrast": "error",
        "heading-order": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "document-title": "error",
        "link-name": "error",
        "button-name": "error",

        "is-on-https": "off",
        "redirects-http": "off",
        "uses-http2": "off",
        "unused-javascript": "off",
        "csp-xss": "off",
        "errors-in-console": "off"
      }
    }
  }
}

---
/**
 * Ported from the old inline quiz, with the accessibility problems fixed:
 * real radio semantics, an aria-live region for feedback, managed focus
 * between questions, and a progress element rather than a bare div.
 *
 * Questions are rendered server-side and revealed one at a time, so the
 * content exists without JavaScript.
 */
const questions = [
  {
    question: 'What is the primary goal of digital forensics?',
    options: [
      'Prevent cyber attacks before they happen',
      'Investigate and analyse digital evidence',
      'Design and build secure networks',
      'Develop new encryption algorithms',
    ],
    correct: 1,
    explanation:
      'Digital forensics is about recovering, preserving and analysing digital evidence to a standard that holds up under scrutiny. Prevention is the job of other security disciplines.',
  },
  {
    question: 'A volatile memory capture should be taken before a disk image because…',
    options: [
      'Memory is larger and takes longer to copy',
      'Disk imaging overwrites the memory contents',
      'Memory contents are lost when the machine loses power',
      'Memory captures do not require a write blocker',
    ],
    correct: 2,
    explanation:
      'Order of volatility: RAM holds running processes, network connections and keys that disappear the moment the machine is powered off. Disk survives, so it can wait.',
  },
  {
    question: 'Which of these best describes defence in depth?',
    options: [
      'Encrypting data with several algorithms at once',
      'Layering independent controls so one failure is not fatal',
      'Running every available scanner against a target',
      'Keeping the network architecture secret',
    ],
    correct: 1,
    explanation:
      'Defence in depth assumes any single control will eventually fail, so independent layers each have to be defeated separately. Secrecy alone is not a control.',
  },
  {
    question: 'What does the "Govern" function added in NIST CSF 2.0 cover?',
    options: [
      'Automated policy enforcement on endpoints',
      'Government reporting requirements for breaches',
      'Organisational risk strategy, roles and oversight',
      'Access control and identity management',
    ],
    correct: 2,
    explanation:
      'CSF 2.0 added Govern alongside Identify, Protect, Detect, Respond and Recover. It covers how an organisation sets, communicates and oversees its risk strategy.',
  },
];
---

<div class="quiz card" data-quiz>
  <div class="quiz-head">
    <p class="quiz-progress-label">
      Question <span data-current>1</span> of {questions.length}
    </p>
    <progress class="quiz-progress" max={questions.length} value="1" aria-label="Quiz progress"
    ></progress>
  </div>

  {
    questions.map((q, qi) => (
      <fieldset class="quiz-step" data-step={qi} hidden={qi !== 0}>
        <legend class="quiz-question">{q.question}</legend>

        <div class="quiz-options">
          {q.options.map((option, oi) => (
            <label class="quiz-option">
              <input type="radio" name={`q${qi}`} value={oi} data-correct={oi === q.correct} />
              <span class="quiz-option-text">{option}</span>
            </label>
          ))}
        </div>

        <div class="quiz-feedback" data-feedback hidden>
          <p class="quiz-verdict" data-verdict />
          <p class="quiz-explanation">{q.explanation}</p>
        </div>

        <button type="button" class="btn btn-secondary quiz-next" data-next hidden>
          {qi === questions.length - 1 ? 'See result' : 'Next question'}
        </button>
      </fieldset>
    ))
  }

  <div class="quiz-result" data-result hidden>
    <p class="quiz-score"><span data-score>0</span> / {questions.length}</p>
    <p class="quiz-message" data-message></p>
    <button type="button" class="btn btn-secondary" data-restart>Try again</button>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-announce></p>
</div>

<style>
  .quiz {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .quiz-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .quiz-progress-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .quiz-progress {
    appearance: none;
    width: 100%;
    height: 3px;
    border: 0;
    border-radius: 999px;
    background: var(--border-subtle);
    overflow: hidden;
  }

  .quiz-progress::-webkit-progress-bar {
    background: var(--border-subtle);
  }

  .quiz-progress::-webkit-progress-value {
    background: var(--accent);
    transition: width 0.35s var(--ease-out-quart);
  }

  .quiz-progress::-moz-progress-bar {
    background: var(--accent);
  }

  .quiz-step {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .quiz-step[hidden] {
    display: none;
  }

  .quiz-question {
    padding: 0;
    font-size: var(--text-lg);
    font-weight: 620;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out-quart),
      background 0.2s var(--ease-out-quart);
  }

  .quiz-option:hover {
    border-color: var(--border-strong);
  }

  /*
    The radio is styled directly rather than hidden behind a decorative span.
    It stays a real, hit-testable, focusable control at a sensible size, which
    matters for touch targets and assistive tech alike.
  */
  .quiz-option input {
    appearance: none;
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    margin: 0.15rem 0 0;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
    background: transparent;
    cursor: inherit;
    transition:
      border-color 0.2s var(--ease-out-quart),
      box-shadow 0.2s var(--ease-out-quart);
  }

  .quiz-option input:checked {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 3.5px var(--accent);
  }

  .quiz-option input:disabled {
    opacity: 0.85;
  }

  .quiz-option.is-correct {
    border-color: var(--success);
    background: var(--success-muted);
  }

  .quiz-option.is-wrong {
    border-color: var(--danger);
    background: var(--danger-muted);
  }

  .quiz-option.is-locked {
    cursor: default;
  }

  .quiz-feedback {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    border: 1px solid var(--border-subtle);
  }

  .quiz-feedback[hidden] {
    display: none;
  }

  .quiz-verdict {
    font-weight: 620;
    font-size: var(--text-sm);
  }

  .quiz-verdict[data-state='correct'] {
    color: var(--success);
  }

  .quiz-verdict[data-state='wrong'] {
    color: var(--danger);
  }

  .quiz-explanation {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .quiz-next {
    margin-top: 1.25rem;
  }

  .quiz-next[hidden] {
    display: none;
  }

  .quiz-result {
    text-align: center;
    padding-block: 1rem;
  }

  .quiz-result[hidden] {
    display: none;
  }

  .quiz-score {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--accent);
  }

  .quiz-message {
    margin-block: 0.5rem 1.5rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const steps = Array.from(quiz.querySelectorAll<HTMLFieldSetElement>('.quiz-step'));
    const progress = quiz.querySelector<HTMLProgressElement>('.quiz-progress');
    const currentLabel = quiz.querySelector<HTMLElement>('[data-current]');
    const result = quiz.querySelector<HTMLElement>('[data-result]');
    const scoreEl = quiz.querySelector<HTMLElement>('[data-score]');
    const messageEl = quiz.querySelector<HTMLElement>('[data-message]');
    const announce = quiz.querySelector<HTMLElement>('[data-announce]');
    const head = quiz.querySelector<HTMLElement>('.quiz-head');
    const restart = quiz.querySelector<HTMLButtonElement>('[data-restart]');

    let score = 0;

    function show(next: number) {
      steps.forEach((step, i) => {
        step.hidden = i !== next;
      });
      if (progress) progress.value = next + 1;
      if (currentLabel) currentLabel.textContent = String(next + 1);

      // Move focus to the new question so keyboard and screen reader users
      // are not left at the bottom of the previous one.
      const legend = steps[next]?.querySelector<HTMLElement>('.quiz-question');
      legend?.setAttribute('tabindex', '-1');
      legend?.focus();
    }

    function finish() {
      steps.forEach((step) => (step.hidden = true));
      if (head) head.hidden = true;
      if (result) result.hidden = false;
      if (scoreEl) scoreEl.textContent = String(score);

      const pct = (score / steps.length) * 100;
      const message =
        pct === 100
          ? 'Full marks. You clearly know your way around this material.'
          : pct >= 60
            ? 'Solid. Worth reading the explanations on the ones you missed.'
            : 'Plenty to dig into — the explanations above cover each answer.';
      if (messageEl) messageEl.textContent = message;
      if (announce) announce.textContent = `Quiz complete. You scored ${score} out of ${steps.length}.`;
      restart?.focus();
    }

    steps.forEach((step, stepIndex) => {
      const feedback = step.querySelector<HTMLElement>('[data-feedback]');
      const verdict = step.querySelector<HTMLElement>('[data-verdict]');
      const next = step.querySelector<HTMLButtonElement>('[data-next]');

      step.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.addEventListener('change', () => {
          const isCorrect = input.dataset.correct === 'true';
          if (isCorrect) score++;

          // Lock the question and mark up the answers
          step.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((other) => {
            other.disabled = true;
            const label = other.closest<HTMLElement>('.quiz-option');
            label?.classList.add('is-locked');
            if (other.dataset.correct === 'true') label?.classList.add('is-correct');
            else if (other.checked) label?.classList.add('is-wrong');
          });

          if (verdict) {
            verdict.textContent = isCorrect ? 'Correct' : 'Not quite';
            verdict.dataset.state = isCorrect ? 'correct' : 'wrong';
          }
          if (feedback) feedback.hidden = false;
          if (next) next.hidden = false;
          if (announce) {
            announce.textContent = `${isCorrect ? 'Correct.' : 'Incorrect.'} ${
              step.querySelector('.quiz-explanation')?.textContent ?? ''
            }`;
          }
        });
      });

      next?.addEventListener('click', () => {
        if (stepIndex === steps.length - 1) finish();
        else show(stepIndex + 1);
      });
    });

    restart?.addEventListener('click', () => {
      score = 0;
      if (result) result.hidden = true;
      if (head) head.hidden = false;

      steps.forEach((step) => {
        step.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
          input.disabled = false;
          input.checked = false;
          input
            .closest<HTMLElement>('.quiz-option')
            ?.classList.remove('is-correct', 'is-wrong', 'is-locked');
        });
        step.querySelector<HTMLElement>('[data-feedback]')!.hidden = true;
        step.querySelector<HTMLButtonElement>('[data-next]')!.hidden = true;
      });

      show(0);
      if (announce) announce.textContent = 'Quiz restarted.';
    });
  });
</script>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const writeups = await getCollection('writeups');
  return writeups
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

interface Props {
  entry: CollectionEntry<'writeups'>;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
const { title, summary, published, updated, tags, readingTime } = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Only h2s make a useful contents list; h3s would over-nest at this length
const toc = headings.filter((h) => h.depth === 2);

// Most recent other writeups
const others = (await getCollection('writeups'))
  .filter((e) => !e.data.draft && e.id !== entry.id)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 2);
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  breadcrumbs={[
    { label: 'Writeups', href: `${base}/writeups` },
    { label: title, href: `${base}/writeups/${entry.id}` },
  ]}
  article={{ published, updated, tags: [...tags] }}
>
  <article class="writeup">
    <header class="head">
      <div class="shell-narrow">
        <a class="back" href={`${base}/writeups`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          All writeups
        </a>

        <div class="meta">
          <time datetime={published.toISOString()}>{dateFormat.format(published)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {
            updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {dateFormat.format(updated)}</span>
              </>
            )
          }
        </div>

        <h1 class="title">{title}</h1>
        <p class="summary">{summary}</p>

        <ul class="tags" aria-label="Topics">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </div>
    </header>

    {
      toc.length > 2 && (
        <nav class="shell-narrow toc" aria-label="On this page">
          <p class="toc-heading">On this page</p>
          <ol class="toc-list">
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="shell-narrow">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="more" aria-labelledby="more-heading">
        <div class="shell-narrow">
          <h2 id="more-heading" class="more-heading">
            More writing
          </h2>
          <ul class="more-list">
            {others.map((other) => (
              <li>
                <a class="card card-interactive more-card" href={`${base}/writeups/${other.id}`}>
                  <time class="more-date" datetime={other.data.published.toISOString()}>
                    {dateFormat.format(other.data.published)}
                  </time>
                  <span class="more-title">{other.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1.5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    transition: color 0.2s var(--ease-out-quart);
  }

  .back:hover {
    color: var(--accent);
  }

  .back svg {
    width: 1rem;
    height: 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .title {
    margin-top: 0.75rem;
    font-size: var(--text-4xl);
  }

  .summary {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  /* Table of contents ------------------------------------------------------ */
  .toc {
    margin-bottom: 2.5rem;
  }

  .toc-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.6rem;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding-left: 1.1rem;
    border-left: 1px solid var(--border-subtle);
    list-style: none;
    counter-reset: toc;
  }

  .toc-list li {
    counter-increment: toc;
  }

  .toc-list a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color 0.2s var(--ease-out-quart);
  }

  .toc-list a::before {
    content: counter(toc) '. ';
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .toc-list a:hover {
    color: var(--accent);
  }

  /* More ------------------------------------------------------------------- */
  .more {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .more-heading {
    font-size: var(--text-xl);
    margin-bottom: 1.25rem;
  }

  .more-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: 1fr;
  }

  .more-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    height: 100%;
  }

  .more-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .more-title {
    font-weight: 620;
  }

  .more-card:hover .more-title {
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    .more-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityQuiz from '../components/SecurityQuiz.astro';
import { certifications, site, timeline } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="About"
  description={`Background, education and certifications of ${site.name}, Computer Security and Forensics student at ${site.university}.`}
  ogType="profile"
>
  <section class="section">
    <div class="shell-narrow">
      <header class="page-head">
        <p class="eyebrow">About</p>
        <h1 class="page-title">How I got here</h1>
      </header>

      <div class="prose intro">
        <p>
          I am a Computer Security and Forensics graduate from {site.university} in Kenya,
          having already completed my undergraduate degree and now awaiting graduation while bringing
          hands-on full-stack development experience, particularly in frontend architecture using Next.js,
          React and TypeScript.
        </p>
        <p>
          My work sits between product design and defensive engineering: I enjoy building polished,
          responsive user interfaces while making sure the system behind them has the right auth,
          encryption, audit, and access controls from the start. That security-first mindset comes
          from both my formal training and the practical problems I have worked on.
        </p>
        <p>
          I am comfortable owning UI/UX design, REST API integration, and the implementation details
          that make a product reliable and trustworthy. The <a class="link" href={`${base}/projects`}>projects page</a>
          shows the kinds of problems I have been solving across frontend, security, and forensic work.
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section section-alt">
    <div class="shell-narrow">
      <header class="section-head reveal">
        <p class="eyebrow">Education</p>
        <h2 class="section-title">Timeline</h2>
      </header>

      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li class="timeline-item reveal">
              <div class="timeline-marker" aria-hidden="true" />
              <div class="timeline-body">
                <p class="timeline-period">{entry.period}</p>
                <h3 class="timeline-title">{entry.title}</h3>
                <p class="timeline-detail">{entry.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section">
    <div class="shell">
      <header class="section-head reveal">
        <p class="eyebrow">Credentials</p>
        <h2 class="section-title">Certifications</h2>
        <p class="lede">Completed alongside the degree.</p>
      </header>

      <div class="cert-grid">
        {
          certifications.map((cert) => (
            <div class="card cert-card reveal">
              <p class="cert-issuer">{cert.issuer}</p>
              <h3 class="cert-title">{cert.title}</h3>
              <p class="cert-note">{cert.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section-alt">
    <div class="shell-narrow">
      <header class="section-head reveal">
        <p class="eyebrow">How I work</p>
        <h2 class="section-title">Approach</h2>
      </header>

      <div class="principles">
        <div class="card principle reveal">
          <h3 class="principle-title">Document as you go</h3>
          <p class="principle-body">
            Forensics taught me that an undocumented finding is not a finding. I write
            things down while I am doing them, not afterwards from memory.
          </p>
        </div>
        <div class="card principle reveal">
          <h3 class="principle-title">Verify before reporting</h3>
          <p class="principle-body">
            Automated tools produce false positives. Handing someone an unverified
            scanner dump wastes their time and costs you their trust.
          </p>
        </div>
        <div class="card principle reveal">
          <h3 class="principle-title">Threat-model the real deployment</h3>
          <p class="principle-body">
            The textbook adversary is rarely the actual one. A shared office laptop has
            a different threat profile to a cloud service, and the controls should differ.
          </p>
        </div>
        <div class="card principle reveal">
          <h3 class="principle-title">Usability is a security property</h3>
          <p class="principle-body">
            A control people route around is not a control. If the secure path is the
            hard path, users will find the easy one.
          </p>
        </div>
      </div>

      <div class="about-cta reveal">
        <a class="btn btn-primary" href={`${base}/contact`}>Get in touch</a>
        <a class="btn btn-secondary" href={`${base}/projects`}>See the work</a>
      </div>
    </div>
  </section>

  <!-- Quiz -->
  <section class="section" id="quiz">
    <div class="shell-narrow">
      <header class="section-head reveal">
        <p class="eyebrow">Interactive</p>
        <h2 class="section-title">Quick security quiz</h2>
        <p class="lede">Four questions. Nothing is stored or sent anywhere.</p>
      </header>
      <div class="reveal">
        <SecurityQuiz />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  .intro {
    font-size: var(--text-lg);
  }

  .section-alt {
    background: var(--surface-inset);
    border-block: 1px solid var(--border-subtle);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-title {
    font-size: var(--text-3xl);
  }

  /* Timeline -------------------------------------------------------------- */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: relative;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.6rem;
    margin-left: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Connector line, hidden on the final entry */
  .timeline-item:not(:last-child) .timeline-marker::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 1.1rem;
    transform: translateX(-50%);
    width: 1px;
    height: calc(100% + 2rem - 1.1rem);
    background: linear-gradient(to bottom, var(--border-default), transparent);
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .timeline-title {
    margin-top: 0.25rem;
    font-size: var(--text-lg);
  }

  .timeline-detail {
    margin-top: 0.4rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  /* Certifications -------------------------------------------------------- */
  .cert-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .cert-card {
    padding: 1.5rem;
  }

  .cert-issuer {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }

  .cert-title {
    margin-top: 0.5rem;
    font-size: var(--text-base);
  }

  .cert-note {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Principles ------------------------------------------------------------ */
  .principles {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .principle {
    padding: 1.5rem;
  }

  .principle-title {
    font-size: var(--text-base);
    color: var(--accent);
  }

  .principle-body {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { availability, contact, site, socials } from '../config/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} about frontend engineering, full-stack product work, or security and digital forensics collaboration.`}
>
  <section class="section">
    <div class="shell contact-layout">
      <!-- Left column: details --------------------------------------------- -->
      <div class="details">
        <header class="page-head">
          <p class="eyebrow">Contact</p>
          <h1 class="page-title">Get in touch</h1>
          <p class="lede">
            Frontend engineering opportunities, product security collaboration, or a quick
            conversation about a role or project — all welcome.
          </p>
        </header>

        <ul class="channels">
          <li>
            <a class="channel" href={`mailto:${contact.email}`}>
              <SocialIcon icon="mail" size="1.1rem" class="channel-icon" />
              <span class="channel-body">
                <span class="channel-label">Email</span>
                <span class="channel-value">{contact.email}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="channel" href={`tel:${contact.phone.tel}`}>
              <svg class="channel-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path
                  d="M3 5.5A2.5 2.5 0 015.5 3h1.8a1 1 0 01.95.68l1.2 3.6a1 1 0 01-.5 1.2l-1.6.8a11 11 0 005.4 5.4l.8-1.6a1 1 0 011.2-.5l3.6 1.2a1 1 0 01.68.95v1.8A2.5 2.5 0 0118.5 21C10 21 3 14 3 5.5z"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="channel-body">
                <span class="channel-label">Phone</span>
                <span class="channel-value" set:html={contact.phone.display.replace(/ /g, '&nbsp;')} />
              </span>
            </a>
          </li>
          {
            socials
              .filter((s) => s.icon !== 'mail')
              .map((social) => (
                <li>
                  <a class="channel" href={social.href} rel="noopener noreferrer" target="_blank">
                    <SocialIcon icon={social.icon} size="1.1rem" class="channel-icon" />
                    <span class="channel-body">
                      <span class="channel-label">{social.label}</span>
                      <span class="channel-value">{social.handle}</span>
                    </span>
                  </a>
                </li>
              ))
          }
        </ul>

        <div class="availability">
          <h2 class="availability-title">Availability</h2>
          <ul class="availability-list">
            {
              availability.map((item) => (
                <li class="availability-item">
                  <span class:list={['badge', `badge-${item.status}`]}>
                    {item.status === 'open' ? 'Open' : 'On request'}
                  </span>
                  <span>
                    <strong class="availability-name">{item.title}</strong>
                    <span class="availability-detail">{item.detail}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <p class="location-note">
          Based in {site.location} · {site.timezone}
        </p>
      </div>

      <!-- Right column: form ------------------------------------------------ -->
      <div class="form-column">
        <form
          id="contact-form"
          class="card form"
          method="post"
          data-endpoint={contact.formEndpoint}
          data-fallback={contact.email}
          novalidate
        >
          <h2 class="form-title">Send a message</h2>

          <!-- Honeypot: invisible to people, irresistible to bots -->
          <div class="honeypot" aria-hidden="true">
            <label for="company-website">Leave this empty</label>
            <input id="company-website" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field">
            <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
            <p class="field-error" id="name-error" data-error-for="name"></p>
          </div>

          <div class="field">
            <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" />
            <p class="field-error" id="email-error" data-error-for="email"></p>
          </div>

          <div class="field">
            <label for="subject">Enquiry type <span class="req" aria-hidden="true">*</span></label>
            <select id="subject" name="subject" required aria-describedby="subject-error">
              <option value="">Choose one…</option>
              <option value="Internship opportunity">Internship opportunity</option>
              <option value="Project collaboration">Project collaboration</option>
              <option value="Security consultation">Security consultation</option>
              <option value="Research partnership">Research partnership</option>
              <option value="Something else">Something else</option>
            </select>
            <p class="field-error" id="subject-error" data-error-for="subject"></p>
          </div>

          <div class="field">
            <label for="organisation">Organisation <span class="optional">(optional)</span></label>
            <input id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required aria-describedby="message-error"></textarea>
            <p class="field-error" id="message-error" data-error-for="message"></p>
          </div>

          <button type="submit" class="btn btn-primary form-submit">Send message</button>

          <p class="form-status" data-status role="status" aria-live="polite" hidden></p>

          {
            !contact.formEndpoint && (
              <p class="form-note">
                This form opens your email app with the message ready to send. Prefer to
                write directly? <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
              </p>
            )
          }
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: var(--text-4xl);
  }

  /* Channels -------------------------------------------------------------- */
  .channels {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    transition:
      border-color 0.2s var(--ease-out-quart),
      background 0.2s var(--ease-out-quart);
  }

  .channel:hover {
    border-color: var(--border-strong);
    background: var(--surface-inset);
  }

  .channel-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .channel-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .channel-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  /* Availability ---------------------------------------------------------- */
  .availability {
    margin-top: 2.5rem;
  }

  .availability-title {
    font-size: var(--text-lg);
    margin-bottom: 1rem;
  }

  .availability-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .availability-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .badge {
    flex-shrink: 0;
    /* Fixed width keeps the item text left-aligned across differing labels */
    min-width: 6.25rem;
    text-align: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .badge-open {
    background: var(--success-muted);
    color: var(--success);
  }

  .badge-on-request {
    background: var(--surface-inset);
    color: var(--text-tertiary);
    border: 1px solid var(--border-subtle);
  }

  .availability-name {
    display: block;
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .availability-detail {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .location-note {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  /* Form ------------------------------------------------------------------ */
  .form {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .form-title {
    font-size: var(--text-xl);
    margin-bottom: 1.5rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field {
    margin-bottom: 1.125rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .req {
    color: var(--accent);
  }

  .optional {
    font-weight: 400;
    color: var(--text-tertiary);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-base);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--text-sm);
    transition:
      border-color 0.2s var(--ease-out-quart),
      box-shadow 0.2s var(--ease-out-quart);
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-muted);
  }

  .field :global([aria-invalid='true']) {
    border-color: var(--danger);
  }

  .field-error {
    margin-top: 0.35rem;
    font-size: var(--text-xs);
    color: var(--danger);
    min-height: 1em;
  }

  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-status {
    margin-top: 1rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    border: 1px solid transparent;
  }

  .form-status[hidden] {
    display: none;
  }

  .form-status[data-state='sending'] {
    background: var(--accent-muted);
    border-color: var(--accent);
    color: var(--accent);
  }

  .form-status[data-state='success'] {
    background: var(--success-muted);
    border-color: var(--success);
    color: var(--success);
  }

  .form-status[data-state='error'] {
    background: var(--danger-muted);
    border-color: var(--danger);
    color: var(--danger);
  }

  .form-note {
    margin-top: 1rem;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  @media (min-width: 60rem) {
    .contact-layout {
      grid-template-columns: 1fr 1.15fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const endpoint = (form.dataset.endpoint ?? '').trim();
    const fallback = form.dataset.fallback ?? '';

    const rules: Record<string, (value: string) => string> = {
      name: (v) => (v.trim().length >= 2 ? '' : 'Please enter your name.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Please enter a valid email address.'),
      subject: (v) => (v ? '' : 'Please choose an enquiry type.'),
      message: (v) => (v.trim().length >= 20 ? '' : 'Please write at least 20 characters.'),
    };

    function setStatus(message: string, state: 'sending' | 'success' | 'error') {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
    }

    function validateField(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): boolean {
      const rule = rules[field.name];
      if (!rule) return true;

      const message = rule(field.value);
      const errorEl = form!.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);
      if (errorEl) errorEl.textContent = message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      return !message;
    }

    // Validate on blur, then live-correct once a field has been marked invalid
    form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((field) => {
      if (!rules[field.name]) return;
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validateField(field);
      });
    });

    function openMailClient(data: FormData) {
      const subject = `Portfolio enquiry: ${data.get('subject') ?? 'General'}`;
      const body = [
        `Name: ${data.get('name') ?? ''}`,
        `Email: ${data.get('email') ?? ''}`,
        `Organisation: ${data.get('organisation') || '—'}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');

      window.location.href = `mailto:${fallback}?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Validate everything so all problems surface at once
      const fields = Array.from(
        form.querySelectorAll<HTMLInputElement>('input, select, textarea')
      ).filter((f) => rules[f.name]);
      const valid = fields.map(validateField).every(Boolean);

      if (!valid) {
        setStatus('Please correct the highlighted fields.', 'error');
        fields.find((f) => f.getAttribute('aria-invalid') === 'true')?.focus();
        return;
      }

      const data = new FormData(form);

      if (data.get('_gotcha')) {
        form.reset();
        return;
      }

      // No backend configured: hand off to the mail client rather than
      // pretending the message was delivered.
      if (!endpoint) {
        openMailClient(data);
        setStatus('Your email app should now open with the message ready to send.', 'success');
        return;
      }

      const label = submit?.textContent ?? '';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }
      setStatus('Sending…', 'sending');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Status ${response.status}`);

        setStatus('Message sent. I will get back to you soon.', 'success');
        form.reset();
        form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => (el.textContent = ''));
        form
          .querySelectorAll('[aria-invalid]')
          .forEach((el) => el.setAttribute('aria-invalid', 'false'));
      } catch (error) {
        console.error('Contact form submission failed:', error);
        setStatus(
          `Sending failed. Opening your email app instead — or write to ${fallback} directly.`,
          'error'
        );
        openMailClient(data);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = label;
        }
      }
    });
  }
</script>

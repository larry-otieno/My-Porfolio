---
import '../styles/global.css';
import Seo, { type ArticleMeta, type Breadcrumb } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMeta;
}

const { title, description, isHome, ogType, breadcrumbs, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme colour tracks the active theme so mobile browser chrome matches -->
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <Seo
      title={title}
      description={description}
      isHome={isHome}
      ogType={ogType}
      breadcrumbs={breadcrumbs}
      article={article}
    />

    <!--
      Applies the stored theme before first paint. Must stay inline and
      render-blocking, otherwise the page flashes the wrong theme on load.
    -->
    <script is:inline>
      /* Mark JS as available before first paint so scroll-reveal elements can
         start hidden. Without this class they stay visible (no-JS fallback). */
      document.documentElement.classList.add('js');
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* private mode - fall back to the system preference */
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      /* Staggered scroll reveal. Elements marked `.reveal` fade + slide in as
         they enter the viewport; siblings inside the same parent are given an
         incrementing `--reveal-i` so a row arrives with rhythm rather than all
         at once. Honours prefers-reduced-motion by revealing everything up
         front and never hiding it. */
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        // Stagger index within each shared parent (reset per group).
        const perParent = new Map<Element, number>();
        for (const el of items) {
          const parent = el.parentElement ?? document.body;
          const i = perParent.get(parent) ?? 0;
          el.style.setProperty('--reveal-i', String(Math.min(i, 6)));
          perParent.set(parent, i + 1);
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );

        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }
</style>

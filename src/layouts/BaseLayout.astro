---
import '../styles/global.css';
import Seo, { type ArticleMeta, type Breadcrumb } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMeta;
}

const { title, description, isHome, ogType, breadcrumbs, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme colour tracks the active theme so mobile browser chrome matches -->
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />

    <Seo
      title={title}
      description={description}
      isHome={isHome}
      ogType={ogType}
      breadcrumbs={breadcrumbs}
      article={article}
    />

    <!--
      Applies the stored theme before first paint. Must stay inline and
      render-blocking, otherwise the page flashes the wrong theme on load.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* private mode - fall back to the system preference */
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }
</style>
